{
  "manifest_version": 3,
  "name": "Job ApplyMate",
  "version": "1.1.3",
  "minimum_chrome_version": "116",
  "description": "你的求职申请搭档：识别并填写网申表单、解析简历和管理投递记录",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel",
    "clipboardWrite",
    "offscreen",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "pdf.worker.min.js", "cmaps/*", "standard_fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
